{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "mcp": {
    "finbank_mcp": {
      "type": "local",
      "command": ["python", "finbank-mcp/server.py"],
      "cwd": ".",
      "enabled": true,
      "timeout": 15000,
      "environment": {
        "LIPARIBANK_PASSWORD": "{env:LIPARIBANK_PASSWORD}"
      }
    }
  },
  "permission": {
    "edit": {
      "*": "allow",
      ".github/workflows/**": "deny",
      "**/*.env*": "deny",
      "**/secrets/**": "deny"
    },
    "bash": {
      "*": "ask",
      "./mvnw test*": "allow",
      "./mvnw verify": "allow",
      "./mvnw.cmd test*": "allow",
      "./mvnw.cmd verify": "allow",
      "docker compose*": "allow",
      "rm -rf*": "deny",
      "git push --force*": "deny"
    }
  }
}